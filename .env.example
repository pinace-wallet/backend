# gRPC endpoint (same host:port Sui full nodes serve JSON-RPC on today; JSON-RPC itself
# is deactivated the week of 2026-07-27 — see sdk.mystenlabs.com/sui/migrations/sui-2.0/json-rpc-migration)
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
# GraphQL endpoint, used for event queries (no gRPC equivalent for module-filtered event queries).
# The Alpha endpoint (sui-testnet.mystenlabs.com/graphql) was decommissioned —
# use the Beta endpoint: https://docs.sui.io/guides/developer/advanced/graphql-migration
SUI_GRAPHQL_URL=https://graphql.testnet.sui.io/graphql
SUI_NETWORK=testnet
PACKAGE_ID=0x5be5ab0292590e61e2dc21d11cc7174970f48e5ff54c88d4797c81b2a751a23b
DATABASE_URL=postgresql://pinace:secret@localhost:5432/pinace_indexer
POLL_INTERVAL_MS=2000
BATCH_SIZE=50
PORT=3001
LOG_LEVEL=info
